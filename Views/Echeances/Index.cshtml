@model IEnumerable<TodoApi.Models.Echeance>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NumeroEcheance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateEcheance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CapitalRembourse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CapitalRestant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amortissement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AssVie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AssInc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IntAdd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalEcheance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Statut)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DatePaiement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InteretRembourse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InteretRestant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdCreditNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NumeroEcheance)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateEcheance)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CapitalRembourse)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CapitalRestant)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Interet)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amortissement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AssVie)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AssInc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IntAdd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalEcheance)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Statut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DatePaiement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InteretRembourse)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InteretRestant)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdCreditNavigation.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
