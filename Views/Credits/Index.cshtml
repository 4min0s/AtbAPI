            <th>
                @Html.DisplayNameFor(model => model.Cout)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Objet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Montant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duree)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbEcheance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeposeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateDeblocage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Franchise)
